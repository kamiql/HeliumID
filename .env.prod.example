# HeliumID — production environment.
#
#   cp .env.prod.example .env.prod
#   # fill every REQUIRED value from your secret manager
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# THIS FILE CONTAINS NO SECRETS AND MUST NEVER CONTAIN ONE. Every value below is either a
# placeholder or empty. `.env.prod` itself is gitignored.
#
# A file on the deploy host is the weakest acceptable option. Concept §7.1 is unambiguous: database
# credentials, client secrets, encryption keys, signing keys, the pepper and the token HMAC key
# belong in Vault / AWS KMS+Secrets Manager / Azure Key Vault / Google Secret Manager, injected at
# start. Treat this file as the migration path to that, not the destination. In particular a `.env`
# is readable by anything that can read the host filesystem, survives in backups, and shows up in
# `docker inspect` output for every container that loads it.

# --- identity of this deployment -------------------------------------------------------------

# Anything other than `dev` disables the dev bootstrap administrator and the verbose error bodies.
HELIUM_ENV=prod

# REQUIRED. The `iss` claim in every token and the base of every URL in the discovery document.
# Must be the exact origin browsers and clients use, https, no trailing slash. Changing it after
# clients exist invalidates every issued token and every registered redirect URI that referenced
# it — this is a value you pick once.
HELIUM_ISSUER_URL=https://id.example.com

# REQUIRED. Exact origins allowed to make credentialed cross-origin calls, comma-separated. Never
# `*` (concept §7.4) — the backend refuses to start on a wildcard, and browsers reject `*` with
# credentials anyway. List first-party apps only; third parties use OAuth, not CORS.
HELIUM_ALLOWED_ORIGINS=https://app.example.com

# --- browser security ---------------------------------------------------------------------------

# true, always. It sets `Secure` and enables the `__Host-` cookie prefix, which the browser then
# enforces for you: no Domain, Path=/, Secure. A misconfiguration becomes a cookie the browser
# refuses rather than a subtly weaker cookie it accepts.
HELIUM_SECURE_COOKIES=true

# Lax so the redirect back from an external identity provider still carries the session cookie.
# Strict breaks that flow; the CSRF defence does not rest on this setting alone (concept §4.5).
HELIUM_SAME_SITE=Lax

# Only true because infra/Caddyfile.prod overwrites X-Forwarded-For with the real peer before
# proxying. If you put anything else in front, verify it does the same. A forwarded header the
# backend trusts but the edge does not sanitise gives every attacker an unlimited supply of source
# IPs, which defeats every per-IP rate limit at once.
HELIUM_TRUST_FORWARDED_HEADERS=true

# --- runtime role ---------------------------------------------------------------------------------

# Set per container by docker-compose.prod.yml: `api` for the request-serving container, `worker`
# for outbox delivery and cleanup, `migrate` for the one-off migration run. Listed here so the set
# of valid values is documented in one place.
# HELIUM_ROLE=api

# false. Migrations are a deliberate, gated release step (concept §3.4), not a side effect of a
# container restarting: replicas coming back after a crash would race Flyway's lock, and
# expand-and-contract migrations have to land between two deploys by definition.
# See docs/operations.md for the runbook.
HELIUM_MIGRATE_ON_START=false

# --- database -----------------------------------------------------------------------------------
#
# REQUIRED. These configure the postgres container and, via docker-compose.prod.yml, the backend's
# connection. Use a generated password; this account owns every password hash, refresh-token hash
# and audit record in the system.
#
#   openssl rand -base64 24
POSTGRES_DB=helium
POSTGRES_USER=helium
POSTGRES_PASSWORD=

# Set by compose from the values above. Point HELIUM_DB_URL at a managed instance instead if you
# are not running Postgres in this compose file — in which case delete the postgres service, and
# keep `sslmode=require` in the URL.
# HELIUM_DB_URL=jdbc:postgresql://db.internal:5432/helium?sslmode=require

# Sized against the database's max_connections divided by the number of app instances, not against
# expected traffic. An oversized pool just relocates the queue into PostgreSQL.
HELIUM_DB_MAX_POOL_SIZE=20

# --- redis ----------------------------------------------------------------------------------------
HELIUM_REDIS_URL=redis://redis:6379/0

# --- key material -----------------------------------------------------------------------------------
#
# REQUIRED. Generate each one separately, never reuse a value across environments or across
# variables:
#
#   openssl rand -base64 32
#
# Token *signing* keys are not configured here. The backend generates EC P-256 keys, stores them
# encrypted under the current data key, and publishes the public half at /.well-known/jwks.json.
# Rotation is an operation with a defined sequence (concept §7.2, docs/operations.md).

# Data-encryption keys for TOTP secrets, stored signing keys and other recoverable secrets.
# Format `version:base64`, comma-separated, 32 bytes decoded each.
#
# Every old version must remain listed after a rotation. The key version is stored alongside each
# ciphertext precisely so old data stays readable; drop a version from this list and you have
# destroyed the TOTP enrolment of every user who has not logged in since.
#
#   HELIUM_DATA_KEYS=1:<old base64>,2:<new base64>
HELIUM_DATA_KEYS=

# Which version new ciphertext is written under. Rotation order matters: publish the new key to
# every instance first, deploy, and only then bump this. Bumping first writes ciphertext under a
# key part of the fleet cannot read.
HELIUM_DATA_KEY_VERSION=1

# REQUIRED. HMAC key used to hash refresh tokens, session handles, email-verification tokens,
# password-reset tokens and recovery codes before storage — none of these are ever stored in the
# clear, so a database dump yields nothing directly replayable.
#
# Minimum 32 bytes decoded; the backend rejects anything shorter. Rotating it logs out every user
# and invalidates every refresh token in one step, which is the correct blast radius for a
# suspected key compromise and far too large for routine hygiene.
HELIUM_TOKEN_HMAC_KEY=

# Optional password pepper, applied before Argon2id and stored outside the database so a
# database-only leak leaves hashes materially harder to crack. Keep it in the secret manager and
# nowhere near a database backup, or it buys you nothing. Empty disables peppering.
#
# The pepper version is recorded in every hash, so it can be introduced or rotated later and old
# hashes keep verifying.
HELIUM_PASSWORD_PEPPER=
HELIUM_PASSWORD_PEPPER_VERSION=1

# --- password hashing -------------------------------------------------------------------------------
#
# MUST be benchmarked on the production hardware (CLAUDE.md, concept §4.1). Target 100–300 ms per
# verification. These are a starting point, not a recommendation:
#
#   64 MiB, t=3, p=2  →  roughly 150 ms on a modern server core
#
# Memory is the parameter that actually costs an attacker with GPUs, so raise memory before
# iterations. Whatever you pick, the container's memory limit in docker-compose.prod.yml has to
# cover memory_kib × concurrent logins, or a credential-stuffing burst becomes an OOM kill.
HELIUM_ARGON2_MEMORY_KIB=65536
HELIUM_ARGON2_ITERATIONS=3
HELIUM_ARGON2_PARALLELISM=2

# --- mail -------------------------------------------------------------------------------------------
#
# REQUIRED. Verification, password-reset and security-notification mail. Delivery is an outbox
# effect executed by the worker, never inline in a database transaction (CLAUDE.md), so a slow or
# unreachable SMTP server delays mail rather than failing registrations.
HELIUM_SMTP_HOST=
HELIUM_SMTP_PORT=587
HELIUM_SMTP_USERNAME=
HELIUM_SMTP_PASSWORD=
# STARTTLS on 587, implicit TLS on 465. Plaintext SMTP means password-reset links crossing the
# network in the clear.
HELIUM_SMTP_STARTTLS=true
HELIUM_SMTP_TLS=false

HELIUM_MAIL_FROM=no-reply@example.com
HELIUM_MAIL_FROM_NAME=Example Identity

# --- external identity providers -----------------------------------------------------------------------
#
# Blank disables the provider. Register exactly this redirect URI, matched exactly by the provider
# and by us:
#
#   https://id.example.com/api/v1/auth/providers/google/callback
#
# Account linking is never implicit: a matching email address does not link an external identity to
# an existing account (CLAUDE.md, concept §9.4). Linking requires an authenticated, explicit
# confirmation, because "same email" is a claim from the provider, not proof of ownership.
HELIUM_GOOGLE_CLIENT_ID=
HELIUM_GOOGLE_CLIENT_SECRET=

# GitHub and Discord are NOT wired up in this milestone. Only the generic OIDC adapter ships
# (provider-oidc), and Google is the configured instance. GitHub is an OAuth API rather than an
# OIDC provider and Discord's identity endpoints are non-standard, so each needs its own adapter
# implementing ExternalIdentityProvider — see provider-spi. Setting these has no effect today;
# they are listed so the naming is settled when the adapters land.
# HELIUM_GITHUB_CLIENT_ID=
# HELIUM_GITHUB_CLIENT_SECRET=
# HELIUM_DISCORD_CLIENT_ID=
# HELIUM_DISCORD_CLIENT_SECRET=
# --- bootstrap ------------------------------------------------------------------------------------------
#
# Intentionally unset. The startup bootstrap only runs when HELIUM_ENV=dev; in production the first
# administrator is created with a one-off command that prints the credential once and writes an
# audit record. See docs/operations.md.
#
# HELIUM_BOOTSTRAP_ADMIN_EMAIL=
# HELIUM_BOOTSTRAP_ADMIN_USERNAME=
# HELIUM_BOOTSTRAP_ADMIN_PASSWORD=

# --- observability --------------------------------------------------------------------------------------------

# json so the structured fields from concept §7.5 (request_id, trace_id, event_type, client_id,
# user_id, outcome, provider, latency) survive into the log pipeline.
HELIUM_LOG_FORMAT=json
# INFO. DEBUG on an identity provider is a liability: it widens what reaches the log pipeline, and
# the one category of data that must never be there is exactly the category debug logging attracts.
HELIUM_LOG_LEVEL=INFO

# --- release ----------------------------------------------------------------------------------------------------

# Tags the built images. Use the git SHA or a release tag rather than `latest`, so a rollback is a
# tag change instead of a rebuild and `docker ps` tells you what is actually running.
HELIUM_VERSION=latest

# --- settings the backend reads that compose does not override ------------------------------------

# Base URL used to build the links inside verification and password-reset emails. Configuration,
# never derived from a request header. Defaults to HELIUM_ISSUER_URL.
HELIUM_PUBLIC_BASE_URL=https://id.example.com

# optional | required | required_for_privileged.
HELIUM_MFA_POLICY=optional

# Bounds concurrent Argon2 hashing. memory_kib x this is the worst-case heap the hasher can hold.
# Benchmark both together in this environment (concept §4.1) rather than trusting the defaults.
HELIUM_ARGON2_CONCURRENCY=4

# Credential lifetimes (concept §4.2).
HELIUM_ACCESS_TOKEN_MINUTES=5
HELIUM_SESSION_IDLE_HOURS=12
HELIUM_SESSION_ABSOLUTE_DAYS=7
HELIUM_REFRESH_IDLE_DAYS=30
HELIUM_REFRESH_ABSOLUTE_DAYS=90
