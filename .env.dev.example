# HeliumID — development environment.
#
#   cp .env.dev.example .env.dev
#   docker compose --env-file .env.dev -f docker-compose.dev.yml up --build
#
# The key material below is a fixed, published placeholder. It is safe precisely because it is
# public: nobody can mistake it for a working secret, and a dev database that survives a laptop
# reboot still decrypts. Never copy a value from this file into .env.prod.
#
# Values that describe the compose network (database host, SMTP host, migrate-on-start) are set in
# docker-compose.dev.yml instead, so they cannot be edited into an inconsistent state here.

# --- identity of this deployment -------------------------------------------------------------

# `dev` unlocks development-only behaviour: the bootstrap administrator below, relaxed cookie
# rules, verbose errors. Anything other than `dev` disables all of it.
HELIUM_ENV=dev

# The `iss` claim in every token and the base of every URL in the discovery document. It must be
# the origin a browser actually uses — a mismatch here shows up as clients rejecting perfectly
# valid tokens, because `iss` validation is exact-match by design.
HELIUM_ISSUER_URL=http://localhost:90

# Exact origins allowed to make credentialed cross-origin calls. Explicit list, never `*`
# (concept §7.4); the backend refuses to start on a wildcard. The SPA is same-origin behind Caddy,
# so this is only for other first-party apps you point at the dev stack.
HELIUM_ALLOWED_ORIGINS=http://localhost:90

# --- browser security ---------------------------------------------------------------------------

# false only because dev is plain HTTP on localhost. It also drops the `__Host-` cookie prefix —
# a cookie claiming `__Host-` without `Secure` is silently ignored by the browser, so the two
# settings move together. Production sets this true and the backend enforces it.
HELIUM_SECURE_COOKIES=false

# Lax lets the OAuth redirect back from a provider carry the session cookie. Strict breaks that
# flow; None would require Secure and is not something to reach for.
HELIUM_SAME_SITE=Lax

# Caddy sits in front and overwrites X-Forwarded-For with the real peer (infra/Caddyfile.dev), so
# trusting it here is safe *in this topology*. Turn it off if you run the backend directly on the
# host: an untrusted forwarded header lets any caller present a fresh IP per request and walk
# straight through the per-IP brute-force limits.
HELIUM_TRUST_FORWARDED_HEADERS=true

# --- runtime role ---------------------------------------------------------------------------------

# api | worker | all | migrate. Dev runs everything in one process so there is one set of logs to
# read; production splits api and worker (docker-compose.prod.yml). Overridden by compose.
HELIUM_ROLE=all

# Dev applies Flyway at boot. Production does not — migrations are a gated release step
# (concept §3.4). Overridden by compose.
HELIUM_MIGRATE_ON_START=true

# --- database -----------------------------------------------------------------------------------
#
# POSTGRES_* configure the postgres container. HELIUM_DB_* are derived from them in
# docker-compose.dev.yml, so change them here and both sides stay in step.
POSTGRES_DB=helium
POSTGRES_USER=helium
POSTGRES_PASSWORD=helium

# Set by compose from the values above; listed for reference and for running the backend outside
# Docker.
# HELIUM_DB_URL=jdbc:postgresql://localhost:5432/helium
# HELIUM_DB_USER=helium
# HELIUM_DB_PASSWORD=helium

# Pool size is bounded by the database's own connection limit *and* by the number of app
# instances. Oversizing it does not add throughput; it moves the queue into PostgreSQL.
HELIUM_DB_MAX_POOL_SIZE=10

# --- redis ----------------------------------------------------------------------------------------
#
# Rate-limit windows and short-lived security transactions only. Correctness must not depend on
# it (CLAUDE.md), so losing it costs you rate-limit history and nothing else.
HELIUM_REDIS_URL=redis://redis:6379/0

# --- key material -----------------------------------------------------------------------------------
#
# Generate real values with:
#
#   openssl rand -base64 32
#
# on Windows without openssl:
#
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
#
# Signing keys for access tokens are NOT here: the backend generates EC P-256 keys itself, stores
# them encrypted under the data key, and publishes the public half at /.well-known/jwks.json.
# Rotating them is an operation, not a config change — see docs/operations.md.

# Data-encryption keys, used for TOTP secrets, stored signing keys and anything else recoverable.
# Format: `version:base64`, comma-separated. Old versions must stay listed after a rotation or
# every ciphertext written under them becomes undecryptable — that is the whole point of the
# version prefix.
HELIUM_DATA_KEYS=1:ZGV2LW9ubHktaW5zZWN1cmUta2V5LWRvLW5vdC11c2U=

# Which version new ciphertext is written with. Rotation is: add the new key to HELIUM_DATA_KEYS,
# deploy, *then* bump this. Bumping first writes ciphertext under a key the fleet does not have.
HELIUM_DATA_KEY_VERSION=1

# HMAC key for hashing refresh tokens, session handles, email tokens and recovery codes before
# they touch the database — none of those are ever stored in the clear. Minimum 32 bytes decoded.
#
# Rotating this invalidates every session and refresh token at once. Sometimes that is the point
# (see the reuse-detection runbook); it is never a thing to do casually.
HELIUM_TOKEN_HMAC_KEY=ZGV2LW9ubHktaW5zZWN1cmUtaG1hYy1kby1ub3QtdXM=

# Optional server-side password pepper, applied before Argon2id. It lives outside the database, so
# a database-only leak leaves the hashes materially harder to attack. Leave empty to disable;
# enabling it later is fine because the pepper version is recorded in every stored hash.
HELIUM_PASSWORD_PEPPER=
HELIUM_PASSWORD_PEPPER_VERSION=1

# --- password hashing -------------------------------------------------------------------------------
#
# Concept §4.1 starting point, tuned down for dev. These MUST be benchmarked in the deployment
# environment (CLAUDE.md): the target is 100–300 ms per verification on production hardware, and
# a parameter set copied from a blog post is a guess, not a decision.
#
# 19 MiB here keeps `docker compose up` responsive and the test suite fast. It is not a security
# setting you should carry anywhere else.
HELIUM_ARGON2_MEMORY_KIB=19456
HELIUM_ARGON2_ITERATIONS=2
HELIUM_ARGON2_PARALLELISM=1

# --- mail -------------------------------------------------------------------------------------------
#
# Mailpit accepts everything and delivers nothing. Host, port and TLS are set by compose; the
# from-address is a product decision, so it lives here.
#
# Read the captured mail at http://localhost:90/mail
HELIUM_MAIL_FROM=no-reply@helium.localhost
HELIUM_MAIL_FROM_NAME=HeliumID (dev)
HELIUM_SMTP_USERNAME=
HELIUM_SMTP_PASSWORD=

# --- external identity providers -----------------------------------------------------------------------
#
# Leave blank to disable a provider entirely. Registered redirect URI for the dev stack:
#
#   http://localhost:90/api/v1/auth/providers/google/callback
#
# Use a throwaway OAuth client for development. A production client secret in a dev .env is a
# production secret on a laptop.
HELIUM_GOOGLE_CLIENT_ID=
HELIUM_GOOGLE_CLIENT_SECRET=

# GitHub and Discord are NOT wired up in this milestone. Only the generic OIDC adapter ships
# (provider-oidc), and Google is the configured instance. GitHub is an OAuth API rather than an
# OIDC provider and Discord's identity endpoints are non-standard, so each needs its own adapter
# implementing ExternalIdentityProvider — see provider-spi. Setting these has no effect today;
# they are listed so the naming is settled when the adapters land.
# HELIUM_GITHUB_CLIENT_ID=
# HELIUM_GITHUB_CLIENT_SECRET=
# HELIUM_DISCORD_CLIENT_ID=
# HELIUM_DISCORD_CLIENT_SECRET=
# --- dev-only bootstrap ------------------------------------------------------------------------------------
#
# Creates one administrator at startup, and only when HELIUM_ENV=dev. It is not a migration on
# purpose: V2__reference_data.sql deliberately seeds no account, because a credential in a
# migration is a credential in source control and in every deployment that ever runs it.
#
# Production creates its first administrator through a one-off command (docs/operations.md).
HELIUM_BOOTSTRAP_ADMIN_EMAIL=admin@helium.localhost
HELIUM_BOOTSTRAP_ADMIN_USERNAME=admin
HELIUM_BOOTSTRAP_ADMIN_PASSWORD=dev-only-change-me

# --- observability --------------------------------------------------------------------------------------------

# json | console. Console is readable in a terminal; production ships json so the fields in
# concept §7.5 survive into the log pipeline.
HELIUM_LOG_FORMAT=console
HELIUM_LOG_LEVEL=DEBUG

# --- settings the backend reads that compose does not override ------------------------------------
#
# Listed here so the full surface is discoverable; the defaults are what the application uses when
# the variable is absent.

# Base URL used to build the links inside verification and password-reset emails. Configuration,
# never derived from a request header — a Host-derived reset link is a reset link an attacker can
# point at their own server. Defaults to HELIUM_ISSUER_URL.
HELIUM_PUBLIC_BASE_URL=http://localhost:90

# optional | required | required_for_privileged. `optional` demands a second factor only from
# users who enrolled one; `required` blocks sign-in until every user has.
HELIUM_MFA_POLICY=optional

# Bounds concurrent Argon2 hashing. memory_kib x this is the worst-case heap the hasher can hold,
# so size it against the container limit — 64 MiB x 4 is 256 MiB.
HELIUM_ARGON2_CONCURRENCY=4

# Credential lifetimes (concept §4.2). Shorten them in dev to exercise expiry paths by hand.
HELIUM_ACCESS_TOKEN_MINUTES=5
HELIUM_SESSION_IDLE_HOURS=12
HELIUM_SESSION_ABSOLUTE_DAYS=7
HELIUM_REFRESH_IDLE_DAYS=30
HELIUM_REFRESH_ABSOLUTE_DAYS=90

# --- host port mappings (dev only) ------------------------------------------------------------
#
# The stack is reachable through Caddy on http://localhost:90; these publish the backend and the
# debugger directly for curl and for attaching an IDE. 8080 is deliberately not the default: it is
# a popular port and on Windows often falls inside a Hyper-V reserved range, where the bind fails
# with a permissions error rather than "address in use".
HELIUM_BACKEND_PORT=18080
HELIUM_DEBUG_PORT=5005
